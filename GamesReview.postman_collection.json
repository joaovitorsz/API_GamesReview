    "name": "GamesReview API",
    "description": "Coleção oficial de testes da API REST GamesReview (Spring Boot + PostgreSQL + Spring Security + JWT).\n\nComo usar:\n1. Execute 'Registrar-usuario' ou 'Login-usuario' na pasta Usuario.\n2. O token JWT retornado será salvo automaticamente na variável {{token}}.\n3. Todas as rotas protegidas já estão configuradas com Bearer Token usando {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Usuario",
      "item": [
        {
          "name": "Registrar-usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    if (data.token) {",
                  "        pm.collectionVariables.set(\"token\", data.token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"João Admin\",\n  \"email\": \"joao@email.com\",\n  \"senha\": \"123\",\n  \"role\": \"ADMIN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
